# Copy to .env and fill in. The server refuses to start without the four
# required settings. Every setting is explained in docs/deploying.md.

# --- required ---

# Your site's exact origin, scheme included. Comma-separate several:
#   ALLOWED_ORIGIN=https://your-domain.com,https://www.your-domain.com
# An origin missing here shows up only as a CORS error in the browser.
ALLOWED_ORIGIN=https://your-domain.com

# Where your days and hours begin. An IANA name such as Europe/Berlin or
# UTC; a fixed offset like +01:00 is refused.
TIMEZONE=Europe/Berlin

# The key your AI agent sends as `Authorization: Bearer <key>`.
# Use at least 32 characters. Generate one: openssl rand -hex 32
MCP_API_KEY=

# The password for /cockpit.
COCKPIT_PASSWORD=

# --- optional ---

#PORT=3000

# Reverse proxies in front: 1 behind one (Traefik, nginx, Caddy), 2 with
# Cloudflare too. Never more than you have, or anyone can fake the
# address every rate limit counts.
#TRUST_PROXY=1

#DB_PATH=/data/genug.db

# Your event definitions, one JSON file each. Seeded with the built-ins
# when empty.
#EVENTS_PATH=/data/events

# What the agent reads before answering: ground-rules.md, about.md,
# history.json. Public on a READ_ONLY deployment.
#CONTEXT_PATH=/data/context

# Days of data kept. -1 keeps everything; 0 is refused.
#RETENTION_DAYS=396

# Query parameters kept on stored URLs, exact names. Everything else is
# removed. Anything you add belongs in your privacy notice.
#KEPT_QUERY_PARAMS=utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_id

# #fragments kept on stored URLs. Unset keeps none.
#KEPT_HASH_VALUES=pricing,faq

# "true" turns off every write and get_recent_events. For a deployment
# whose MCP key is public, such as a demo.
#READ_ONLY=false

# A daily backup beside the database, 7 days kept. Copy it off the host
# yourself.
#LOCAL_BACKUPS=true

# Asks GitHub once a day whether a newer version exists. Sends no data.
#UPDATE_CHECK=true
