# Copy to .env and fill in. The three secrets below have no defaults —
# the server refuses to start without them, deliberately, rather than
# coming up in an insecure or unidentifiable state.

# --- required ---

# The tracked site's own origin, for CORS on /events. Exact origin,
# scheme included — not a wildcard, and not a bare domain. Comma-separate
# several if the site serves on more than one origin, e.g. an apex plus a
# www. host that doesn't redirect, or a staging host reporting here too:
#   ALLOWED_ORIGIN=https://your-domain.com,https://www.your-domain.com
# An origin that isn't listed fails inside the browser as a CORS error,
# which never reaches this server's logs — so check this first if events
# aren't arriving.
ALLOWED_ORIGIN=https://your-domain.com

# Shared secret the AI agent sends as `Authorization: Bearer <key>` to
# reach /mcp. Generate one: openssl rand -hex 32
MCP_API_KEY=

# Password for /cockpit. Typed once on its sign-in page, which sets a
# 12-hour session cookie; changing this signs out every browser.
# Required: /cockpit exposes recent event URLs and raw props.
COCKPIT_PASSWORD=

# --- optional ---

# Defaults to 3000.
#PORT=3000

# How many reverse-proxy hops sit in front of this server. Unset means
# none: X-Forwarded-For is believed from nobody, which is right when the
# port is published directly. Set 1 behind a single proxy (Coolify's
# Traefik, nginx, Caddy), 2 behind that plus Cloudflare.
# Do not set it higher than the number of proxies you really have — the
# header is text the sender writes, so an extra trusted hop lets anyone
# forge the address every rate limiter counts, the cockpit password
# lockout included.
#TRUST_PROXY=1

# Defaults to /data/genug.db — already the path the Docker and
# Coolify instructions mount a persistent volume at, so most
# deployments never need to set this.
#DB_PATH=/data/genug.db

# Directory holding your own event schema files (one JSON file per
# event). Defaults to /data/events, on the same persistent volume as
# the database — so you can drop files in and restart without
# rebuilding the image. It is created and seeded with the built-in
# events on first start; after that it is yours to edit.
#EVENTS_PATH=/data/events

# Directory holding what you want your AI agent to know before it
# answers: ground-rules.md, the instructions it should follow, and
# history.json, things that happened to the site (an outage, a campaign)
# so it can explain a change rather than guess at one. Defaults to
# /data/context, on the same persistent volume. Both are seeded on first
# start; after that they are yours to edit, and an edit applies on the
# next question with no restart.
#
# On a READ_ONLY deployment the MCP key is public, so whatever is in
# here is readable by anyone holding it. Don't put anything private in
# it there.
#CONTEXT_PATH=/data/context

# Delete events, rejected events and bot activity older than this many
# days, once at startup and daily after. Unset defaults to 396 (13
# months) — set -1 to keep everything forever instead, on purpose (0 is
# refused: "0 days" reads as "keep nothing", the opposite of this).
#RETENTION_DAYS=396

# Which query parameters survive on a stored URL, comma-separated and
# matched case-insensitively. Everything else is dropped by the client
# before it sends and again on arrival — a newsletter link's ?email=, a
# reset link's token, a site search's typed query. Unset keeps the six
# utm_* parameters. Exact names only: add click ids by name if you want
# them (gclid,fbclid,msclkid,ttclid). "*" keeps every parameter, and
# with it every email address and token a URL carries.
#KEPT_QUERY_PARAMS=utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_id

# Which #fragments survive, matched exactly against the whole fragment
# (a leading # is optional). Unset keeps none: an OAuth response puts
# its access token there. "*" keeps every fragment.
#KEPT_HASH_VALUES=pricing,faq

# Closes every write: the MCP tools that write (delete_visitor_data,
# add_history_note) are not
# registered, and the cockpit refuses edits, new events, reloads and
# both resets. Collection on /events continues. For a deployment whose
# MCP key is public, such as a demo. Only "true" or "false".
#READ_ONLY=false

# Daily local backup next to the database, keeping 7 days — the
# database plus a copy of EVENTS_PATH, which a restore needs to make
# sense of it. On by default; set to false to opt out. This protects
# against mistakes, not against losing the volume — an off-host copy is
# still your job.
#LOCAL_BACKUPS=true
